# CryptoJackal Configuration
# Copy this file to .env and fill in your values

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
ENVIRONMENT=development

# Ethereum Configuration
ETH_NODE_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
CHAIN_ID=1
PRIVATE_KEY=

# Trading Configuration
TRADE_AMOUNT=0.1
MAX_SLIPPAGE=0.5
MIN_LIQUIDITY=10000
MAX_PRICE_IMPACT=3.0
SCAN_INTERVAL_SECONDS=180
GAS_LIMIT=300000
MAX_GAS_PRICE_GWEI=100

# Paper Trading (set to true for simulation mode)
PAPER_TRADING_MODE=true
INITIAL_BALANCE=10.0

# Safety Rails (Live Trading - conservative defaults)
MAX_DAILY_LOSS_PCT=5.0
MAX_TRADE_SIZE_PCT=1.0
TRADE_COOLDOWN_MINUTES=5
MAX_OPEN_POSITIONS=3
KILL_SWITCH_ENABLED=true

# API Keys (optional, improves rate limits)
COINGECKO_API_KEY=
DEXSCREENER_API_KEY=

# API Tier (determines rate limits and scan interval)
# free = gratis (3 min scan, conservative limits)
# basic = CoinGecko Basic $29/mo (1 min scan, 3x limits, requires COINGECKO_API_KEY)
# analyst = CoinGecko Analyst $103/mo (30s scan, 5x limits, requires COINGECKO_API_KEY)
API_TIER=free

# Multi-source data providers
GECKOTERMINAL_ENABLED=true

# Rate limiting cooldown (minutes after 429 error)
API_COOLDOWN_MINUTES=5

# Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Security
ADMIN_PASSWORD=admin
JWT_SECRET=change-me-in-production-use-a-long-random-string
CORS_ORIGINS=*

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379

# Backtesting
BACKTEST_DEFAULT_BALANCE=10000
BACKTEST_DEFAULT_FEE_PCT=0.1
BACKTEST_MAX_CANDLES=1000
